#include <stdio.h>
int main()
{
    int a[32][32], b[32][32], c[32][32], i, j, m, n, k, r, s, choice;
    do
    {
        printf("\n========== MATRIX CALCULATOR ==========\n");
        printf("1->Multiply of two matrices\n");
        printf("2->Addition of two matrices \n");
        printf ("3-> Exit calculation\n");
        printf("Enter your choice:\n ");
        scanf("%d", &choice);
    if (choice==1)
    {
    printf("Enter the rows and columns of A matrix:\n");
    scanf("%d%d", &m, &n);
    printf("Enter the rows and columns of B matrix:\n");
    scanf("%d%d", &r, &s);
    if(n != r)
    {
        printf("Matrix multiplication not possible!\n");
        printf("Columns of A (%d) must equal Rows of B (%d)\n", n, r);
        continue;
    }
    printf("Enter the elements of A matrix:\n");
    for(i = 0; i < m; i++)
    {
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);
    }
    printf("Enter the elements of B matrix:\n");
    for(i = 0; i < r; i++)
    {
        for(j = 0; j < s; j++)
            scanf("%d", &b[i][j]);
    }
    printf("\nThe elements of A matrix are:\n");
    for(i = 0; i < m; i++)
    {
        printf("\n");
        for(j = 0; j < n; j++)
            printf("\t%d", a[i][j]);
    }
    printf("\nThe elements of B matrix are:\n");
    for(i = 0; i < r; i++)
    {
        printf("\n");
        for(j = 0; j < s; j++)
            printf("\t%d", b[i][j]);
    }
    for(i = 0; i < m; i++)
    {
        for(j = 0; j < s; j++)
        {
            c[i][j] = 0;
        }
    }
    for(i = 0; i < m; i++)  
    {
        for(j = 0; j < s; j++)      
        {
            for(k = 0; k < n; k++)   
            {
                c[i][j] += a[i][k] * b[k][j];
            }
        }
    }
    printf("\nThe Multiplication of two matrices:\n");
    for(i = 0; i < m; i++)
    {
        printf("\n");
        for(j = 0; j < s; j++)
            printf("\t%d", c[i][j]);
    }
    }
else if (choice==2)
{
    printf("Enter the rows and columns of the matrices:\n");
    scanf("%d%d", &m, &n);
     printf("Enter the elements of Matrix A:\n");
    for(i = 0; i < m; i++)
    {
        for(j = 0; j < n; j++)
            scanf("%d", &a[i][j]);
    }
    printf("Enter the elements of Matrix B:\n");
    for(i = 0; i < m; i++)
    {
        for(j = 0; j < n; j++)
            scanf("%d", &b[i][j]);
    }
    
    printf("\nElements of Matrix A:\n");
    for(i = 0; i < m; i++)
    {
        printf("\n");
        for(j = 0; j < n; j++)
            printf("\t%d", a[i][j]);
    }
    
    printf("\nElements of Matrix B:\n");
    for(i = 0; i < m; i++)
    {
        printf("\n");
        for(j = 0; j < n; j++)
            printf("\t%d", b[i][j]);
    }
    
    printf("\nThe addition of the two matrices:\n");
    for(i = 0; i < m; i++)
    {
        printf("\n");
        for(j = 0; j < n; j++)
        {
            c[i][j] = a[i][j] + b[i][j];
            printf("\t%d", c[i][j]);
        }
    }
}
}
while(choice!=3);
printf("Thanks for using our matrics calculator\n");
    return 0;
}
