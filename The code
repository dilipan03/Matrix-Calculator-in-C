#include <stdio.h>

int main() {
    int a[32][32], b[32][32], c[32][32], i, j, m, n, k, r, s, choice;

    do {
        printf("\n========== MATRIX CALCULATOR ==========\n");
        printf("1->Multiply of two matrices\n");
        printf("2->Addition of two matrices\n");
        printf("3->Subtraction of two matrices\n");
        printf("4->Exit calculation\n");
        printf("Enter your choice: ");

        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter rows and columns of Matrix A:\n");
            scanf("%d%d", &m, &n);

            printf("Enter rows and columns of Matrix B:\n");
            scanf("%d%d", &r, &s);

            if (n != r) {
                printf("Matrix multiplication not possible!\n");
            } else {
                printf("Enter elements of Matrix A:\n");
                for(i = 0; i < m; i++)
                    for(j = 0; j < n; j++)
                        scanf("%d", &a[i][j]);

                printf("Enter elements of Matrix B:\n");
                for(i = 0; i < r; i++)
                    for(j = 0; j < s; j++)
                        scanf("%d", &b[i][j]);

                for(i = 0; i < m; i++) {
                    for(j = 0; j < s; j++) {
                        c[i][j] = 0;
                        for(k = 0; k < n; k++) {
                            c[i][j] += a[i][k] * b[k][j];
                        }
                    }
                }

                printf("\nMultiplication Result:\n");
                for(i = 0; i < m; i++) {
                    printf("\n");
                    for(j = 0; j < s; j++) {
                        printf("\t%d", c[i][j]);
                    }
                }
            }
        }

        else if (choice == 2) {
            printf("Enter the rows and columns:\n");
            scanf("%d%d", &m, &n);

            printf("Enter elements of Matrix A:\n");
            for(i = 0; i < m; i++)
                for(j = 0; j < n; j++)
                    scanf("%d", &a[i][j]);

            printf("Enter elements of Matrix B:\n");
            for(i = 0; i < m; i++)
                for(j = 0; j < n; j++)
                    scanf("%d", &b[i][j]);

            printf("\nAddition (A+B):\n");
            for(i = 0; i < m; i++) {
                printf("\n");
                for(j = 0; j < n; j++) {
                    c[i][j] = a[i][j] + b[i][j];
                    printf("\t%d", c[i][j]);
                }
            }
        }

        else if (choice == 3) {
            printf("Enter the rows and columns:\n");
            scanf("%d%d", &m, &n);

            printf("Enter elements of Matrix A:\n");
            for(i = 0; i < m; i++)
                for(j = 0; j < n; j++)
                    scanf("%d", &a[i][j]);

            printf("Enter elements of Matrix B:\n");
            for(i = 0; i < m; i++)
                for(j = 0; j < n; j++)
                    scanf("%d", &b[i][j]);

            printf("\nSubtraction (A-B):\n");
            for(i = 0; i < m; i++) {
                printf("\n");
                for(j = 0; j < n; j++) {
                    c[i][j] = a[i][j] - b[i][j];
                    printf("\t%d", c[i][j]);
                }
            }
        }

        else if (choice == 4) {
            printf("Thanks for using our matrix calculator!\n");
            break;
        }

        else {
            printf("Invalid choice!\n");
        }


    } while (choice != 4);

    return 0;
}
